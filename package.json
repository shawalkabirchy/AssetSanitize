{
  "name": "assetsanitize",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, verified image metadata removal in your browser.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/generate-notices.mjs",
    "build": "next build --webpack",
    "preview": "serve out -l 4173 --no-clipboard",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/create-fixtures.mjs",
    "portfolio": "node scripts/capture-portfolio.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "exifr": "7.1.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "exifreader": "4.52.0",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
